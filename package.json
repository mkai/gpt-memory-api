    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "hono": "^4.7.2",
